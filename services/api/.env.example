# Runtime (non-secret unless noted)
APP_ENV=development
APP_VERSION=0.1.0
BUILD_ID=local
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=127.0.0.1,localhost,testserver
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
AI_ANALYSIS_ENABLED=true
NOTIFICATION_SCAN_INTERVAL_SECONDS=300
SCANNER_BATCH_SIZE=100
SCANNER_LOCK_TTL_SECONDS=3600
SCANNER_MODE=local
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_RETENTION_SECONDS=3600
COMMUNICATIONS_ENABLED=false
EMAIL_PROVIDER=console
SMS_PROVIDER=console
ALLOW_CONSOLE_DELIVERY=false

# Backend secrets: never expose these to Vite/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-service-role-key
OPENAI_API_KEY=your-openai-api-key
