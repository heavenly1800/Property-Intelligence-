# Non-secret Render values
APP_ENV=staging
APP_VERSION=0.1.0
BUILD_ID=replace-with-git-commit-or-release-id
API_HOST=0.0.0.0
API_PORT=10000
# PORT is generated by Render. Do not manually set it.
FRONTEND_ORIGINS=https://property-intelligence-staging.vercel.app
TRUSTED_HOSTS=property-intelligence-api-staging.onrender.com
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=false
LOG_LEVEL=INFO
AI_ANALYSIS_ENABLED=true
COMMUNICATIONS_ENABLED=false
EMAIL_PROVIDER=console
SMS_PROVIDER=console
ALLOW_CONSOLE_DELIVERY=false
NOTIFICATION_SCAN_INTERVAL_SECONDS=600
SCANNER_BATCH_SIZE=100
SCANNER_LOCK_TTL_SECONDS=3600
SCANNER_MODE=oneshot
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_RETENTION_SECONDS=3600

# Dashboard-entered backend values. Service role and OpenAI keys are secrets.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
OPENAI_API_KEY=replace-with-staging-openai-key
