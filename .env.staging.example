APP_ENV=staging
APP_VERSION=0.1.0
BUILD_ID=replace-with-release-id
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGINS=https://staging.example.com
TRUSTED_HOSTS=api-staging.example.com,backend
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=false
LOG_LEVEL=INFO
AI_ANALYSIS_ENABLED=true
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
OPENAI_API_KEY=replace-with-staging-openai-key
COMMUNICATIONS_ENABLED=false
EMAIL_PROVIDER=console
SMS_PROVIDER=console
ALLOW_CONSOLE_DELIVERY=false
NOTIFICATION_SCAN_INTERVAL_SECONDS=300
SCANNER_BATCH_SIZE=100
SCANNER_MODE=oneshot
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_RETENTION_SECONDS=3600

# Public build variables
VITE_API_URL=https://api-staging.example.com
VITE_SUPABASE_URL=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-staging-anon-key
